<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>GleanInside.RevitPlugin</AssemblyName>
    <RootNamespace>GleanInside.RevitPlugin</RootNamespace>
    <!-- Change this to match your Revit installation year -->
    <RevitVersion>2024</RevitVersion>
    <RevitInstallPath>C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit API — not redistributable, must be present on build machine -->
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallPath)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallPath)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy the addin manifest next to the DLL for easy deployment -->
    <None Include="GleanInside.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
