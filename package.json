{
  "name": "gleaninside",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "postinstall": "npm --prefix server install",
    "dev": "concurrently -n web,api -c blue,green --kill-others-on-fail \"vite\" \"npm --prefix server run dev\"",
    "dev:web": "vite",
    "dev:server": "npm --prefix server run dev",
    "dev:widget": "vite build --config vite.widget.config.mts --watch",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:widget": "vite build --config vite.widget.config.mts",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "mcp": "ruler apply",
    "mcp:revert": "ruler revert"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@mdi/font": "7.4.47",
    "dom-to-image-more": "^3.7.2",
    "dompurify": "^3.4.5",
    "marked": "^18.0.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3",
    "vuetify": "^4.0.2"
  },
  "devDependencies": {
    "@intellectronica/ruler": "^0.3.37",
    "@tsconfig/node22": "^22.0.5",
    "@types/dompurify": "^3.0.5",
    "@types/html2canvas": "^0.5.35",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.39.4",
    "eslint-config-vuetify": "^4.3.4",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.98.0",
    "typescript": "~5.9.3",
    "unplugin-fonts": "^1.4.0",
    "vite": "^8.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.2.5"
  },
  "overrides": {
    "unplugin-fonts": {
      "vite": "^8.0.0"
    }
  }
}
